<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         CHANGESET 1: Add columns to "customers" table
         ================================================================ -->
    <changeSet id="002-add-phone-to-customers" author="schema-admin">
        <comment>Add phone_number column to customers table</comment>
        <addColumn tableName="customers">
            <column name="phone_number" type="STRING"/>
        </addColumn>
    </changeSet>

    <changeSet id="002-add-loyalty-tier-to-customers" author="schema-admin">
        <comment>Add loyalty_tier and total_spent columns to customers</comment>
        <addColumn tableName="customers">
            <column name="loyalty_tier" type="STRING"/>
            <column name="total_spent" type="NUMERIC"/>
        </addColumn>
    </changeSet>

    <!-- ================================================================
         CHANGESET 2: Add columns to "orders" table
         ================================================================ -->
    <changeSet id="002-add-discount-to-orders" author="schema-admin">
        <comment>Add discount and shipping_cost columns to orders</comment>
        <addColumn tableName="orders">
            <column name="discount" type="FLOAT64"/>
            <column name="shipping_cost" type="NUMERIC"/>
        </addColumn>
    </changeSet>

    <changeSet id="002-add-notes-to-orders" author="schema-admin">
        <comment>Add notes column to orders</comment>
        <addColumn tableName="orders">
            <column name="notes" type="STRING"/>
        </addColumn>
    </changeSet>

    <!-- ================================================================
         CHANGESET 3: Add a top-level STRUCT column to "events" (raw SQL)
         BigQuery supports ALTER TABLE ADD COLUMN for new top-level STRUCTs.
         ================================================================ -->
    <changeSet id="002-add-audit-struct-to-events" author="schema-admin">
        <comment>Add a new top-level STRUCT column (audit_info) to events table</comment>
        <sql>
            ALTER TABLE events
            ADD COLUMN IF NOT EXISTS audit_info STRUCT&lt;
                created_by STRING,
                updated_by STRING,
                updated_at TIMESTAMP
            &gt;
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 4: Add a top-level ARRAY column to "products"
         ================================================================ -->
    <changeSet id="002-add-tags-to-products" author="schema-admin">
        <comment>Add a repeated STRING column (tags) to products</comment>
        <sql>
            ALTER TABLE products
            ADD COLUMN IF NOT EXISTS tags ARRAY&lt;STRING&gt;
        </sql>
    </changeSet>

    <!-- Tag after column additions -->
    <changeSet id="002-tag-columns-added" author="schema-admin">
        <tagDatabase tag="columns-added-v2"/>
    </changeSet>

</databaseChangeLog>
