<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Master Changelog — includes all child changelogs in execution order.
        Each file covers a specific category of schema operations.
    -->

    <!-- 1. Create base tables (flat + nested STRUCT) -->
    <include file="db/changelog/001-create-tables.xml"/>

    <!-- 2. Add new columns to existing tables -->
    <include file="db/changelog/002-add-columns.xml"/>

    <!-- 3. Modify data types of existing columns -->
    <include file="db/changelog/003-modify-datatypes.xml"/>

    <!-- 4. Drop columns -->
    <include file="db/changelog/004-drop-columns.xml"/>

    <!-- 5. Rename columns -->
    <include file="db/changelog/005-rename-columns.xml"/>

    <!-- 6. Nested STRUCT/RECORD operations (BigQuery-specific workarounds) -->
    <include file="db/changelog/006-nested-struct-operations.xml"/>

    <!-- 7. Create and drop views -->
    <include file="db/changelog/007-views.xml"/>

    <!-- 
      8+. SQL-FIRST MIGRATION EXAMPLES
      Future state migrations should use raw SQL files wrapped in XML.
      
      Example:
      <include file="db/changelog/008-example-sql-wrapper.xml"/>
      
      Where `008-example-sql-wrapper.xml` contains:
      <changeSet id="008..." author="..." context="...">
          <sqlFile path="db/changelog/sql/ddl/008-script.sql" splitStatements="true" stripComments="true"/>
          <rollback>
              <sqlFile path="db/changelog/sql/rollback/008-script.sql" splitStatements="true" stripComments="true"/>
          </rollback>
      </changeSet>
    -->
</databaseChangeLog>
