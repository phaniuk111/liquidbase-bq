<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         CHANGESET 1: Rename a top-level column in "orders"
         BigQuery supports ALTER TABLE RENAME COLUMN.
         ================================================================ -->
    <changeSet id="005-rename-status-in-orders" author="schema-admin">
        <comment>Rename orders.status to order_status for clarity</comment>
        <sql>
            ALTER TABLE orders
            RENAME COLUMN status TO order_status
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 2: Rename a top-level column in "customers"
         ================================================================ -->
    <changeSet id="005-rename-is-active-in-customers" author="schema-admin">
        <comment>Rename customers.is_active to active_flag</comment>
        <sql>
            ALTER TABLE customers
            RENAME COLUMN is_active TO active_flag
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 3: Rename a column in "products"
         ================================================================ -->
    <changeSet id="005-rename-name-in-products" author="schema-admin">
        <comment>Rename products.name to product_name</comment>
        <sql>
            ALTER TABLE products
            RENAME COLUMN name TO product_name
        </sql>
    </changeSet>

    <!-- Tag after renames -->
    <changeSet id="005-tag-columns-renamed" author="schema-admin">
        <tagDatabase tag="columns-renamed-v5"/>
    </changeSet>

</databaseChangeLog>
