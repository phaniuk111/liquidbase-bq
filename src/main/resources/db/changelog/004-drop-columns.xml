<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         CHANGESET 1: Drop a top-level column from "customers"
         BigQuery supports ALTER TABLE DROP COLUMN for top-level columns.
         ================================================================ -->
    <changeSet id="004-drop-phone-from-customers" author="schema-admin">
        <comment>Drop phone_number column from customers (was added in 002)</comment>
        <sql>
            ALTER TABLE customers
            DROP COLUMN IF EXISTS phone_number
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 2: Drop a top-level column from "orders"
         ================================================================ -->
    <changeSet id="004-drop-notes-from-orders" author="schema-admin">
        <comment>Drop notes column from orders</comment>
        <sql>
            ALTER TABLE orders
            DROP COLUMN IF EXISTS notes
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 3: Drop a top-level STRUCT column from "events"
         Top-level STRUCT columns CAN be dropped via ALTER TABLE.
         ================================================================ -->
    <changeSet id="004-drop-audit-from-events" author="schema-admin">
        <comment>Drop the audit_info STRUCT column from events</comment>
        <sql>
            ALTER TABLE events
            DROP COLUMN IF EXISTS audit_info
        </sql>
    </changeSet>

    <!-- Tag after drops -->
    <changeSet id="004-tag-columns-dropped" author="schema-admin">
        <tagDatabase tag="columns-dropped-v4"/>
    </changeSet>

</databaseChangeLog>
