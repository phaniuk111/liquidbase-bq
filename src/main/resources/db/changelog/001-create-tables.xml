<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================
         CHANGESET 1: Create flat "customers" table
         ================================================================ -->
    <changeSet id="001-create-customers" author="schema-admin">
        <comment>Create customers table with basic flat columns</comment>
        <createTable tableName="customers">
            <column name="customer_id" type="STRING">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="STRING"/>
            <column name="last_name" type="STRING"/>
            <column name="email" type="STRING"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="is_active" type="BOOL"/>
        </createTable>
    </changeSet>

    <!-- ================================================================
         CHANGESET 2: Create flat "orders" table
         ================================================================ -->
    <changeSet id="001-create-orders" author="schema-admin">
        <comment>Create orders table with basic flat columns</comment>
        <createTable tableName="orders">
            <column name="order_id" type="STRING">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="STRING"/>
            <column name="amount" type="FLOAT64"/>
            <column name="currency" type="STRING"/>
            <column name="status" type="STRING"/>
            <column name="order_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ================================================================
         CHANGESET 3: Create flat "products" table
         ================================================================ -->
    <changeSet id="001-create-products" author="schema-admin">
        <comment>Create products table</comment>
        <createTable tableName="products">
            <column name="product_id" type="STRING">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="price" type="NUMERIC"/>
            <column name="category" type="STRING"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ================================================================
         CHANGESET 4: Create "events" table WITH NESTED STRUCT columns
         Uses raw SQL because Liquibase XML does not support BigQuery
         STRUCT / RECORD / ARRAY<STRUCT> types natively.
         ================================================================ -->
    <changeSet id="001-create-events-nested" author="schema-admin">
        <comment>
            Create events table with nested STRUCT columns:
            - location: STRUCT (city, state, country)
            - metadata: ARRAY of STRUCT (key-value pairs)
            - device:   STRUCT with nested STRUCT (browser info)
        </comment>
        <sql>
            CREATE TABLE IF NOT EXISTS events (
                event_id     STRING NOT NULL,
                event_type   STRING,
                user_id      STRING,
                event_time   TIMESTAMP,

                -- Nested STRUCT: single record
                location STRUCT&lt;
                    city    STRING,
                    state   STRING,
                    country STRING
                &gt;,

                -- Nested ARRAY of STRUCT: repeated key-value metadata
                metadata ARRAY&lt;STRUCT&lt;
                    key   STRING,
                    value STRING
                &gt;&gt;,

                -- Deeply nested STRUCT: device → browser (nested inside nested)
                device STRUCT&lt;
                    os      STRING,
                    version STRING,
                    browser STRUCT&lt;
                        name    STRING,
                        version STRING
                    &gt;
                &gt;
            )
        </sql>
    </changeSet>

    <!-- ================================================================
         CHANGESET 5: Create "user_profiles" table with complex nesting
         Demonstrates ARRAY<STRUCT> with nested STRUCTs inside.
         ================================================================ -->
    <changeSet id="001-create-user-profiles-nested" author="schema-admin">
        <comment>
            Create user_profiles table with deeply nested structures:
            - addresses: ARRAY of STRUCT (multiple addresses per user)
            - preferences: STRUCT with nested STRUCT
        </comment>
        <sql>
            CREATE TABLE IF NOT EXISTS user_profiles (
                user_id    STRING NOT NULL,
                username   STRING,
                email      STRING,
                created_at TIMESTAMP,

                -- ARRAY of STRUCT: user can have multiple addresses
                addresses ARRAY&lt;STRUCT&lt;
                    address_type STRING,
                    street       STRING,
                    city         STRING,
                    state        STRING,
                    zip_code     STRING,
                    country      STRING,
                    is_primary   BOOL
                &gt;&gt;,

                -- Nested STRUCT with sub-STRUCT
                preferences STRUCT&lt;
                    language     STRING,
                    timezone     STRING,
                    notification STRUCT&lt;
                        email_enabled BOOL,
                        sms_enabled   BOOL,
                        push_enabled  BOOL
                    &gt;
                &gt;
            )
        </sql>
    </changeSet>

    <!-- Tag: baseline -->
    <changeSet id="001-tag-baseline" author="schema-admin">
        <tagDatabase tag="baseline-v1"/>
    </changeSet>

</databaseChangeLog>
