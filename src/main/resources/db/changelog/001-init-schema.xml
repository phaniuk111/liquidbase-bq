<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-init-schema" author="schema-admin">
        <comment>Initialize baseline schema from final consolidated SQL</comment>
        <sqlFile path="db/changelog/sql/ddl/001-init-schema.sql" 
                 splitStatements="true" 
                 stripComments="true"/>
        <rollback>
            <sqlFile path="db/changelog/sql/rollback/001-init-schema.sql" 
                     splitStatements="true" 
                     stripComments="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
